# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# IntelliJ IDEA 기본 포맷 설정
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java 파일
[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 120

# JavaScript, TypeScript, JSX, TSX
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
max_line_length = 120

# JSON, YAML
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# XML, HTML
[*.{xml,html}]
indent_style = space
indent_size = 2

# Properties files
[*.properties]
indent_style = space
indent_size = 4
